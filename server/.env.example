NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=gm_platform

# mysql2 풀 커넥션 수(인스턴스당) — 생략 시 기본값 10. 스케일아웃 시 총 커넥션 = 이 값 × 인스턴스 수이므로 MySQL max_connections와 맞춰 조정
DB_CONNECTION_LIMIT=10

# 부팅 시 MySQL 최초 연결 확인을 지수 백오프로 재시도할 최대 누적 시간(ms) — 생략 시 기본값 60000(1분).
# MySQL 컨테이너가 이 서버보다 늦게 뜨는 배포 순서에서도 즉시 종료하지 않고 기다린다.
# DB_BOOT_RETRY_MAX_MS=60000

# log_audit 전용 DB — 메인 DB와 같은 VM/인스턴스라는 보장이 없어 완전히 별도로 설정한다 (database_log/ 참고)
LOG_DB_HOST=127.0.0.1
LOG_DB_PORT=3306
LOG_DB_USER=root
LOG_DB_PASSWORD=your_log_db_password
LOG_DB_NAME=gm_platform_log
LOG_DB_CONNECTION_LIMIT=10

JWT_SECRET=your_jwt_secret_key
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# phone_number 암호화(AES-256-CBC) 키 — 32바이트 hex(64자). `npm run keygen`으로 생성
ENCRYPTION_KEY=your_64_char_hex_encryption_key

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PORT=3000

LOG_DEBUG_ERRORS=false

SWAGGER_ENABLED=true

# API 실행(S2S) 호출 타임아웃(ms) — 생략 시 기본값 10000
API_EXECUTION_TIMEOUT_MS=10000

# 로그인/회원가입 브루트포스 방지 리미터 — 생략 시 기본값 900000(15분)/10회
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# 만료된 user_session 정리 크론 표현식 — 생략 시 기본값 매일 새벽 4시(0 4 * * *)
SESSION_CLEANUP_CRON=0 4 * * *

# 로그인 리미터 등 캐시성 기능의 Redis 사용 여부 — false(기본)면 인메모리로 폴백(스케일아웃 시 인스턴스별로 분리됨)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_KEY_PREFIX=gm:

# Redis 명령 타임아웃(ms) — 생략 시 기본값 1000. Redis 장애 시 ioredis 기본 재시도(최대 20회, 누적 최대 수십초)를
# 기다리지 않고 이 시간 안에 실패로 확정시켜, Redis 장애가 API 응답 지연으로 그대로 전이되지 않게 한다.
# 너무 짧게 잡으면(예: 200ms) 서버 부팅 시점 rate-limit-redis의 SCRIPT LOAD가 커넥션 수립과 경합해 타임아웃되고,
# 그 실패가 캐싱돼 이후 Redis가 멀쩡해도 로그인이 프로세스 재기동 전까지 계속 실패하는 문제가 실측으로 확인됨.
# REDIS_COMMAND_TIMEOUT_MS=1000

# 세션(jti) 캐시 TTL(초)·generation 카운터 TTL(초) — 둘 다 생략 가능. 생략 시 JWT_ACCESS_EXPIRES_IN을 초로
# 환산한 값과 그 2배가 각각 기본값이 된다(Access Token보다 짧게 캐싱해봤자 이득이 없어서 그 값에 맞춤).
# 명시적으로 설정할 경우 SESSION_GEN_TTL_SECONDS는 반드시 SESSION_CACHE_TTL_SECONDS보다 커야 함(아니면 기동 시 에러).
# SESSION_CACHE_TTL_SECONDS=1800
# SESSION_GEN_TTL_SECONDS=3600

# rag_server(문서 검색) 연동 여부 — false(기본)면 GET /doc-search 라우트 자체가 등록되지 않는다(rag_server 실행 없이도 정상 기동)
RAG_ENABLED=false
RAG_BASE_URL=http://127.0.0.1:3200
# rag_server의 RAG_API_KEY와 동일한 값. 미설정 시(로컬 개발용) 헤더 없이 호출한다
RAG_API_KEY=
