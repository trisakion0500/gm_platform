PORT=3200

# 바인딩할 인터페이스 — 생략 시 기본값 127.0.0.1(신뢰된 내부망 전용 설계 전제를 코드로 강제).
# 여러 원격 호출자를 허용해야 하는 분리 배포 시나리오에서만 값을 바꾸고, 그 경우 IP 화이트리스트 등
# 별도 방어를 추가로 검토해야 한다(RAG_API_KEY만으로는 네트워크 노출 자체를 막지 못함).
# HOST=127.0.0.1

# @xenova/transformers 모델 이름 — 최초 실행 시 1회 다운로드 후 오프라인 사용(768차원, ~283MB)
# 원래 Xenova/paraphrase-multilingual-MiniLM-L12-v2(384차원)를 썼으나, "기술 스택"류 짧은/일반 질의에서
# 무관한 청크가 상위에 뜨는 anisotropy(hubness) 문제가 실측으로 확인돼 검색 전용으로 학습된 이 모델로
# 교체했다 — 모델 교체 시 rag_server/src/index/store.ts의 VECTOR_SIZE도 함께 바꾸고 재인덱싱해야 한다.
# multilingual-e5 계열은 "query: "/"passage: " 프리픽스가 필수(reindex.ts/search.service.ts에 이미 반영됨)
# — 다른 계열로 바꾸면 이 프리픽스 로직도 함께 재검토해야 한다(docs/21_RAG_SERVER.md §3.1)
EMBEDDING_MODEL=Xenova/multilingual-e5-base

# Qdrant (로컬에 이미 떠있는 인스턴스 사용)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=gm_docs

# Qdrant 클라이언트 응답 대기 타임아웃(ms) — 생략 시 기본값 60000. 라이브러리 자체 기본값(300000=5분)이
# 그대로면 Qdrant가 응답 없이 멈춘 상태에서 검색 요청이 5분까지 물릴 수 있어 명시적으로 좁혔다. 재인덱싱의
# 대량 upsert(현재 코퍼스 기준 실측 32~40초)도 이 값 하나를 함께 쓰므로, 코퍼스가 크게 늘어나 그 시간이
# 이 값에 근접하면 함께 늘려야 한다(docs/21_RAG_SERVER.md §3.1).
# QDRANT_TIMEOUT_MS=60000

# 부팅 시 모델 로딩+재인덱싱(warmUp/reindexIfChanged) 재시도 최대 누적 시간(ms) — 생략 시 기본값 60000.
# MySQL/Qdrant가 이 서버보다 늦게 뜨는 배포 순서에서도 즉시 포기하지 않고 지수 백오프로 기다린다.
# RAG_BOOT_RETRY_MAX_MS=60000

# X-API-Key 검증값. 미설정 시(로컬 개발용) 검증을 건너뛴다 — 실사용 전 반드시 설정해야 한다(docs/21_RAG_SERVER.md §3)
RAG_API_KEY=

# GM Platform 본체(server/)와 동일한 MySQL 인스턴스/DB를 가리켜야 한다.
# rag_server 전용 테이블은 없음 — 재인덱싱 인스턴스 간 상호배제용 advisory lock(SP_LOCK_ACQUIRE/SP_LOCK_RELEASE)만 재사용한다(docs/21_RAG_SERVER.md §3)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=gm_platform
