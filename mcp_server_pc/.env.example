# GM Platform API base URL (예: http://127.0.0.1:3000/api)
GM_BASE_URL=http://127.0.0.1:3000/api

# 이 MCP 서버가 로그인할 GM Platform 계정 — role_code에 따라 노출되는 tool이 달라짐
# SUPER_ADMIN 계정이면 회사/프로젝트/사용자 admin tool까지 전부 노출된다
GM_LOGIN_ID=sa
GM_PASSWORD=1234

# search_docs tool(문서 검색) 사용 여부. false면 RAG_BASE_URL 없이도 기동 가능, tool 자체가 등록되지 않는다
RAG_ENABLED=false

# rag_server(문서 검색) base URL — GM Platform 로그인과 무관. RAG_ENABLED=true일 때만 필수
RAG_BASE_URL=http://127.0.0.1:3200

# rag_server의 RAG_API_KEY와 동일한 값. 미설정 시(로컬 개발용) 헤더 없이 호출한다
RAG_API_KEY=
