{
  "mcpServers": {
    "gm-platform-pc": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/absolute/path/to/gm_platform/mcp_server_pc/dist/index.js"
      ],
      "env": {
        "GM_BASE_URL": "http://127.0.0.1:3000/api",
        "GM_LOGIN_ID": "sa",
        "GM_PASSWORD": "1234",
        "RAG_ENABLED": "false",
        "RAG_BASE_URL": "http://127.0.0.1:3200",
        "RAG_API_KEY": ""
      }
    }
  }
}
